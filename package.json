{
  "name": "@purduehackers/phack",
  "version": "0.2.0",
  "description": "Typed API client and CLI for Purdue Hackers short links",
  "homepage": "https://phack.rs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purduehackers/puhack.horse.git"
  },
  "bin": {
    "phack": "./dist/cli.js"
  },
  "files": [
    "dist/client.js",
    "dist/cli.js",
    "dist/types/src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/src/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build && bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build web/main.ts --outdir dist --minify && bun build src/server.ts --target bun --outfile dist/server.js --external elysia --external drizzle-orm/libsql",
    "typecheck": "tsc --noEmit",
    "prepack": "bun build src/client.ts src/cli.ts --outdir dist --target bun --packages external && tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist/types",
    "test": "bun test",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@elysiajs/eden": "^1.4.9",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "1.0.0-rc.5",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "1.0.0-rc.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
