{
  "name": "@purduehackers/phack",
  "version": "0.2.0",
  "bin": {
    "phack": "./src/cli.ts"
  },
  "files": [
    "src",
    "web",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun run build && bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build web/main.ts --outdir dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:import": "bun scripts/import-links.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@elysiajs/eden": "^1.4.9",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "1.0.0-rc.5",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "1.0.0-rc.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
