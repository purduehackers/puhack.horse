{
  "name": "@purduehackers/phack-cli",
  "version": "0.1.0",
  "description": "Create and look up Purdue Hackers short links.",
  "homepage": "https://github.com/purduehackers/puhack.horse/tree/main/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purduehackers/puhack.horse.git",
    "directory": "cli"
  },
  "bin": {
    "phack": "./index.ts"
  },
  "files": [
    "*.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run format --check"
  },
  "dependencies": {
    "better-result": "^3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rayhanadev/ox": "0.4.0",
    "@types/bun": "^1.4.4",
    "oxclippy": "^0.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.0"
}
